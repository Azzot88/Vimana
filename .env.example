# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=vimana
POSTGRES_PASSWORD=vimana_dev
POSTGRES_DB=vimana_dev
DATABASE_URL=postgresql+asyncpg://vimana:vimana_dev@db:5432/vimana_dev
TEST_DATABASE_URL=postgresql+asyncpg://vimana:vimana_dev@db:5432/vimana_test

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ── DealVault at-rest encryption (T1.21) ─────────────────────────────────────
# AES-256-GCM key for message text. Generate with: openssl rand -base64 32
# In prod: MUST be set — startup fails if the key is empty on first encrypt/decrypt.
# In dev/tests: conftest.py provides a deterministic default so pytest runs offline.
MESSAGE_ENCRYPTION_KEY=

# ── Nostr keypair encryption (T2.2) ──────────────────────────────────────────
# AES-256-GCM key for user's nsec (private Nostr key). Separate from
# MESSAGE_ENCRYPTION_KEY so compromising one doesn't compromise the other.
# Generate: openssl rand -base64 32
# Losing this key = losing all custodial nsec's. Back it up.
NSEC_ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production — set to your domain.
# Dev/staging default: * (all). Production: https://vimana.dealvault.club
CORS_ORIGINS=*

# ── Rate limiting (slowapi) ───────────────────────────────────────────────────
# Set to "false" to disable in tests. Default: true.
RATE_LIMIT_ENABLED=true

# ── Redis / Celery ────────────────────────────────────────────────────────────
# REDIS_PASSWORD is required: docker-compose starts Redis with `--requirepass`
# and refuses to come up without it. Generate with `openssl rand -hex 24` — hex
# so the value survives being pasted into a URL without escaping.
# Write the SAME password into both lines by hand: `env_file` hands values to
# the container verbatim, so a `${REDIS_PASSWORD}` reference inside REDIS_URL
# would arrive at the app as those literal characters.
# The app and Celery read REDIS_URL only; the compose file reads REDIS_PASSWORD.
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────────
# VITE_API_URL: НЕ задавать при деплое с nginx-прокси (frontend + backend на одном хосте).
# Пустое значение → axios шлёт запросы на текущий origin → nginx проксирует /api/* в backend.
# Задать только для локальной разработки без nginx: VITE_API_URL=http://localhost:8000
# VITE_API_URL=

# ── Cloudflare R2 (DealVault attachments) ────────────────────────────────────
# Access keys — Dashboard → R2 → Manage R2 API Tokens → Create API Token
#   (Object Read & Write for the bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name only (not URL).
R2_BUCKET=
# S3-compatible endpoint WITHOUT bucket path.
# Example: https://<account_id>.r2.cloudflarestorage.com
# Do NOT include /vimana at the end — bucket goes in R2_BUCKET.
R2_ENDPOINT=

# ── SMTP (notifications) ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587

# ── Email verification (T3.11) ───────────────────────────────────────────────
# Comma-separated email domains whose registrations are marked verified without
# a code. Exists so the e2e suites stop minting codes nobody reads.
# MUST STAY EMPTY IN PRODUCTION — a verified flag should mean someone actually
# opened that mailbox. The backend logs a startup warning if it is set.
# dev: E2E_AUTO_VERIFY_EMAIL_DOMAINS=e2e.vimana.local
E2E_AUTO_VERIFY_EMAIL_DOMAINS=

# ── Malware scanning for uploads (T3.8 follow-up) ────────────────────────────
# Host of the clamd instance.
#
# **Fail-open with a queue** (owner's decision 2026-08-02). Whether this is set
# or not, an upload is never blocked by the scanner being absent or unreachable:
# the file is stored with `scan_status = 'pending'`, the administrators are told
# (throttled to hourly), and `tasks.malware_rescan` picks it up later. Only a
# found signature refuses an upload outright.
#
# The trade that buys: between upload and the deferred scan, the file is
# downloadable by the counterparty unscanned. `pending` is therefore never a
# synonym for safe — see `core/file_validation.py`.
#
# Turning it on for the first time hands the rescan task the entire history,
# because every file stored before it existed is `pending` too. That is
# intended; it drains at 100/hour.
#
# The container is not started by default (~1.5–2 GB RAM for the signature
# database, see the compose file):
#   docker compose -f docker-compose.dev.yml --profile clamav up -d clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Nostr publishing under the platform key (T3.12) ──────────────────────────
# 64-hex private key the platform signs trip listings with, for carriers who
# have not taken their own identity yet. MUST be different from
# CHAIN_ANCHOR_NSEC: "this trip exists" and "this is our unaltered chain head"
# are separate claims and must not share a signer.
PLATFORM_PUBLISH_NSEC=
# ── Chain anchoring (T3.6 / T3.20) ───────────────────────────────────────────
# 64-hex key the platform signs chain-head anchors with. Unset → anchoring is a
# silent no-op, which is what it was until T3.20.
#
# Separate from PLATFORM_PUBLISH_NSEC on purpose, and not any user's key: an
# anchor is the platform attesting to its own records, and a signer that also
# signs deal events would make it impossible to tell which of the two is
# speaking. Generate with (on the server, backend container):
#   python -c "from app.core.keypair import generate_keypair; print(generate_keypair()[0])"
# Anchoring also needs NOSTR_PUBLISH_ENABLED=true and at least one third-party
# relay in NOSTR_FRIENDLY_RELAYS — a head that only ever reached our own strfry
# proves nothing about us, which is the entire point of anchoring.
CHAIN_ANCHOR_NSEC=
# Which trips go out: interesting (default) | all | none.
# "interesting" currently means a rare corridor — see core/publish_filter.py.
NOSTR_PUBLISH_FILTER=interesting
# A corridor with more than this many prior trips stops being newsworthy.
NOSTR_PUBLISH_RARE_CORRIDOR_MAX=3
# Master switch for everything that leaves the server: trip listings and chain
# anchors both check it. Default false, and it stayed undocumented here until
# T_SEC.4 — a variable the code reads but `.env.example` never mentions is one
# nobody knows to set.
NOSTR_PUBLISH_ENABLED=false
# Where our own strfry lives, from the backend's side of the compose network.
# Plain ws:// is correct here: this connection never leaves the host.
NOSTR_OWN_RELAY_URL=ws://nostr-relay:7777
# What we tell the world (NIP-11, links, docs). TLS is terminated by nginx and
# the relay answers under /relay — see nginx/default.conf.
NOSTR_RELAY_URL=wss://vimana.dealvault.club/relay
# Third-party relays we broadcast to. Whitelist lives in TECHSTATE
# D-NOSTR-FEDERATION; empty means "publish only to our own".
# Chosen for one property only: they accept writes from a key nobody has heard
# of. Verified on the first live anchoring tick (2026-08-01), when the previous
# list turned out to contain none that do:
#   nostr.wine        — paid, answers "restricted: sign up at ... to write"
#   relay.nostr.band  — indexer, times out on publish
#   relay.damus.io    — HTTP 503 on the websocket handshake from this host
# An anchor is worth exactly the third parties that hold it, so a list of relays
# that all refuse is the same as no anchoring at all — while looking configured.
NOSTR_FRIENDLY_RELAYS=wss://nos.lol,wss://relay.primal.net,wss://offchain.pub,wss://nostr.mom

# ── WebAuthn / passkeys (T3.14) ──────────────────────────────────────────────
# RP_ID must be the site's domain (or a parent of it); ORIGIN must match the
# browser's origin exactly, scheme included. A mismatch makes the browser abort
# the ceremony before anything reaches the server — nothing to see in the logs.
# prod: WEBAUTHN_RP_ID=vimana.dealvault.club
#       WEBAUTHN_ORIGIN=https://vimana.dealvault.club
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Vimana
WEBAUTHN_ORIGIN=http://localhost:5173

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret sent as X-Telegram-Bot-Api-Secret-Token header on webhook requests.
# Set when calling POST /api/telegram/set_webhook. If empty — no verification (dev only).
TELEGRAM_WEBHOOK_SECRET=

# ── Admin (waitlist + notifications) ──────────────────────────────────────────
# Secret header token for GET /api/waitlist (list all entries)
ADMIN_API_TOKEN=
# Comma-separated Telegram chat_ids notified when someone joins the waitlist
ADMIN_TELEGRAM_CHAT_IDS=

# ── Security (T_SEC.1) ───────────────────────────────────────────────────────
# Docs surface (/docs, /redoc, /openapi.json) — CLOSED by default (fail-safe).
# Set to "true" only when you actively need Swagger for debugging, then remove.
# Requires backend restart (--build or --force-recreate); simple `docker
# compose restart` won't reload env.
# EXPOSE_DOCS=true

# ── Deploys (T_OPS.1) ────────────────────────────────────────────────────────
# How long the backend keeps serving after `/ready` starts answering 503 on
# SIGTERM. A balancer needs two or three failed checks to take the instance out
# of rotation; this is the window that lets it. Default 5 s.
#
# Must stay well below `stop_grace_period` in docker-compose (40 s), which also
# has to cover uvicorn's `--timeout-graceful-shutdown` (20 s) — otherwise Docker
# kills the process in the middle of shutting down gracefully.
#
# Raise it when the balancer checks rarely; 0 disables the pause entirely.
# DRAIN_SECONDS=5
#
# One uvicorn worker per core. Default 2, which is what a two-core box wants.
# UVICORN_WORKERS=2

# Geolocation for the new-device letter (T_SEC.6). Path INSIDE the container —
# the file is mounted read-only into celery-worker from ./data/geoip.
# Unset or missing file → the letter goes out without the location line, which
# is a working state, not a broken one.
# The database is MaxMind GeoLite2 City, downloaded with a free account and
# kept out of git (licence, size, and its own refresh schedule).
# GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Phase 2 (REQUIRED — registration fails without it) ──────────────────────
# 32-byte base64 AES-256-GCM key for wrapping user Nostr nsec.
# Generate: openssl rand -base64 32
# NEVER reuse the value of MESSAGE_ENCRYPTION_KEY — the isolation is the whole
# point of having two keys. Losing the value = losing all encrypted nsec.
NSEC_ENCRYPTION_KEY=

# ── Phase 2+ (uncomment when needed) ─────────────────────────────────────────
# KYC_PROVIDER_API_KEY=

# ── Phase 3+ ──────────────────────────────────────────────────────────────────
# PAYMENT_PROVIDER_KEY=

# ── Phase 5+ ──────────────────────────────────────────────────────────────────
# BTC_ESCROW_ARBITER_KEY_REF=  # pointer to KMS entry — never the key itself
# USDT_ESCROW_RPC_URL=

# ── Phase 6+ ──────────────────────────────────────────────────────────────────
# IPFS_GATEWAY_URL=
# NOSTR_RELAY_URL=
