# T_TEST.8 / T_TEST.12 — credentials for the long-lived e2e accounts.
# Copy to `.env.local` (git-ignored) and fill in. Real environment variables
# take precedence, so CI can set them without a file.
#
# Each account is registered by hand once, through the normal code-based flow,
# on a mailbox a person can actually read — the code is stored as a bcrypt hash
# and cannot be recovered from the database or the logs. Then a password is set
# **on the account**, through the product's own step-up; sign-up by code creates
# none, and `/login` refuses a passwordless account with the same 401 it uses for
# a wrong password.
E2E_USER=niktrifonov83@gmail.com
E2E_PASSWORD=

# The second account exists for the one thing a single account cannot do — be
# two people at once. `invite-flow` needs somebody other than the author to
# accept an invite; the endpoint refuses your own with a 400. Nothing else uses
# it, so if that spec is not being run this can stay empty.
E2E_USER2=contact@dealvault.club
E2E_PASSWORD2=
