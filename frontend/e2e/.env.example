# T_TEST.8 — credentials for the long-lived e2e account.
# Copy to `.env.local` (git-ignored) and fill in. Real environment variables
# take precedence, so CI can set them without a file.
#
# The account is registered by hand once, through the normal code-based flow,
# on a mailbox a person can actually read — the code is stored as a bcrypt hash
# and cannot be recovered from the database or the logs.
E2E_USER=niktrifonov83@gmail.com
E2E_PASSWORD=
