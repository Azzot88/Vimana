{
  "name": "vimana-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "headed": "playwright test --headed --slow-mo=500",
    "headed:single": "playwright test --headed --slow-mo=500 --workers=1",
    "trace": "playwright test --trace=on",
    "ci": "playwright test --project=chromium",
    "show-trace": "playwright show-trace",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
