{
  "name": "vimana-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "headed": "playwright test --headed",
    "headed:single": "playwright test --headed --workers=1",
    "trace": "playwright test --trace=on",
    "ci": "playwright test --project=chromium",
    "a11y": "playwright test specs/a11y.spec.ts --project=chromium",
    "show-trace": "playwright show-trace",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0"
  }
}
